# 校园集项目环境变量示例，复制为 .env 或直接注入到系统中
# 后端 application.yml 已为所有变量提供默认值，本地开发通常无需修改

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=campus_market
DB_USERNAME=campus
DB_PASSWORD=Campus@2026

# 生产环境必须替换为 32 字节以上的随机串
JWT_SECRET=campus-market-dev-secret-key-please-change-in-production-0123456789

UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173
SERVER_PORT=8080
